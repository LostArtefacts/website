{# def second_nav=None, wide=False, active=None #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lost Artefacts</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="{{ url_for('static', filename='lostartefacts.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='main.css') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='pygments.css') }}">
  <script>
    // Resolve the theme before first paint to avoid a flash of the wrong one.
    (function () {
      var stored;
      try {
        stored = localStorage.getItem('theme');
      } catch (e) {
        stored = null;
      }
      document.documentElement.dataset.theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    })();
  </script>
</head>
<body>

  <div>
    <MainNav active={{ active }}/>

    {% if second_nav %}
      {{ second_nav }}
    {% endif %}

    <main class="outer-container main {% if wide %}wide {% endif %}">
      {{ content }}
    </main>
  </div>

  <Footer/>

  <script src="{{ url_for('static', filename='main.js') }}"></script>
</body>
</html>
