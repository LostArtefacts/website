{# def branches, commit_sha, current_branch, nav, doc=None, query='' #}
<aside class="docs-sidebar" id="docs-sidebar">
  <BranchSelector branches={{ branches }} current_branch={{ current_branch }}/>

  <form class="docs-search" action="{{ url_for('trx_docs_search', branch=current_branch) }}" method="get" role="search">
    <input type="search" name="q" value="{{ query }}" placeholder="Search docs…" aria-label="Search documentation"/>
  </form>

  {% macro nav_label(nav_doc) -%}
    {% if nav_doc.content %}
      <a href="{{ url_for('trx_docs', branch=current_branch, doc_path=nav_doc.rel_slug) }}" {% if nav_doc == doc %}class="active"{% endif %}>
        {{ nav_doc.title }}
      </a>
    {% else %}
      <span {% if nav_doc == doc %}class="active"{% endif %}>{{ nav_doc.title }}</span>
    {% endif %}
  {%- endmacro %}

  {# sections stay closed unless the document being read lives inside them,
     so the thirty Lua modules don't bury everything else #}
  {% macro render_nav(docs_list) -%}
  <ul class="no-bullets">
    {% for nav_doc in docs_list %}
      <li>
        {% if nav_doc.children %}
          <details data-section="{{ nav_doc.rel_slug }}" {% if doc and nav_doc.has_child(doc) %}open{% endif %}>
            <summary>{{ nav_label(nav_doc) }}</summary>
            {{ render_nav(nav_doc.children) }}
          </details>
        {% else %}
          {{ nav_label(nav_doc) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  {%- endmacro %}

  {{ render_nav(nav) }}

  <p>
    <Link href={{ "https://github.com/LostArtefacts/TRX/commit/" + commit_sha }}>{{ commit_sha[0:7] }}</Link>
  </p>
</aside>

<script>
  // The sidebar is its own scroll container and every doc is a fresh page
  // load, so its offset is carried across navigations by hand. This runs here
  // rather than on DOMContentLoaded so it lands before first paint.
  (function () {
    var sidebar = document.getElementById('docs-sidebar');
    if (!sidebar) {
      return;
    }

    var scrollKey = 'docs-sidebar-scroll';
    var sectionsKey = 'docs-sections';
    var sections = {};

    // Sections a reader has opened or closed by hand stay that way from here
    // on. Only sections they have actually touched are stored, so the rest
    // keep following the server's rule of "open if it holds this document".
    try {
      sections = JSON.parse(localStorage.getItem(sectionsKey) || '{}') || {};
    } catch (e) {
    }

    var toggles = sidebar.querySelectorAll('details[data-section]');
    toggles.forEach(function (details) {
      var id = details.getAttribute('data-section');
      if (Object.prototype.hasOwnProperty.call(sections, id)) {
        details.open = !!sections[id];
      }
    });

    // ...except that the document being read must never end up inside a
    // collapsed section, whatever was stored for it
    var active = sidebar.querySelector('.active');
    var section = active && active.closest('details');
    while (section) {
      section.open = true;
      section = section.parentElement
        && section.parentElement.closest('details');
    }

    // listeners go on last: the adjustments above are not the reader's doing
    // and must not be written back as if they were
    toggles.forEach(function (details) {
      details.addEventListener('toggle', function () {
        sections[details.getAttribute('data-section')] = details.open;
        try {
          localStorage.setItem(sectionsKey, JSON.stringify(sections));
        } catch (e) {
        }
      });
    });

    // the offset is restored after the sections settle, since what is open
    // decides what the offsets mean
    try {
      var saved = sessionStorage.getItem(scrollKey);
      if (saved !== null) {
        sidebar.scrollTop = parseFloat(saved) || 0;
      }
    } catch (e) {
    }

    // whatever the stored offset was, the entry for the document being read
    // has to be visible: it may have been reached from a link in the body, or
    // from outside the site entirely
    if (active) {
      var top = active.offsetTop;
      var bottom = top + active.offsetHeight;
      if (top < sidebar.scrollTop
          || bottom > sidebar.scrollTop + sidebar.clientHeight) {
        sidebar.scrollTop = top - sidebar.clientHeight / 2;
      }
    }

    window.addEventListener('pagehide', function () {
      try {
        sessionStorage.setItem(scrollKey, sidebar.scrollTop);
      } catch (e) {
      }
    });
  })();
</script>
